{
  "job_defaults": {
    "GlueVersion": "4.0",
    "WorkerType": "G.1X",
    "NumberOfWorkers": 5,
    "Timeout": 2880,
    "MaxRetries": 1,
    "ExecutionProperty": {
      "MaxConcurrentRuns": 3
    }
  },
  "spark_configuration": {
    "spark.sql.adaptive.enabled": "true",
    "spark.sql.adaptive.coalescePartitions.enabled": "true",
    "spark.sql.adaptive.skewJoin.enabled": "true",
    "spark.sql.shuffle.partitions": "200",
    "spark.default.parallelism": "200",
    "spark.executor.memory": "8g",
    "spark.executor.cores": "4",
    "spark.driver.memory": "4g",
    "spark.sql.files.maxRecordsPerFile": "500000",
    "spark.sql.sources.partitionOverwriteMode": "dynamic"
  },
  "iceberg_configuration": {
    "spark.sql.extensions": "org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions",
    "spark.sql.catalog.glue_catalog": "org.apache.iceberg.spark.SparkCatalog",
    "spark.sql.catalog.glue_catalog.warehouse": "s3://my-iceberg-datalake/warehouse/",
    "spark.sql.catalog.glue_catalog.catalog-impl": "org.apache.iceberg.aws.glue.GlueCatalog",
    "spark.sql.catalog.glue_catalog.io-impl": "org.apache.iceberg.aws.s3.S3FileIO"
  },
  "logging": {
    "enable-metrics": true,
    "enable-continuous-cloudwatch-log": true,
    "enable-continuous-log-filter": true,
    "continuous-log-logGroup": "/aws-glue/jobs/",
    "enable-spark-ui": true
  },
  "security": {
    "enable-s3-encryption": true,
    "s3-encryption-mode": "SSE-S3",
    "enable-catalog-encryption": true,
    "catalog-encryption-mode": "SSE-KMS"
  }
}
